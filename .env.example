# Copy to .env and change. .env is gitignored.
POSTGRES_PASSWORD=devpass

# LLM provider (DigitalOcean Serverless Inference). Leave LLM_URL empty for echo mode.
LLM_URL=
# LLM_URL=https://inference.do-ai.run/v1/chat/completions
LLM_MODEL=openai-gpt-oss-120b
# Model access key from the team's DigitalOcean account. Secret: never commit .env.
LLM_API_KEY=
